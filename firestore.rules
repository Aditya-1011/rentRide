// Private users/{uid}: uid immutable; phoneNumber nullable and token matched;
// displayName string 2..60; roles server managed; onboardingCompleted true;
// createdAt immutable timestamp; updatedAt server timestamp.
// _otpChallenges, _otpRates and _emailOtp contain server-only OTP data.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function verifiedIdentity() {
      return request.auth.token.get('email_verified', false) == true
        || request.auth.token.get('phone_number', null) != null;
    }
    function validUser(data) {
      return data.keys().hasAll(['uid', 'phoneNumber', 'displayName', 'roles',
          'onboardingCompleted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'phoneNumber', 'displayName', 'roles',
          'onboardingCompleted', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.uid is string && data.uid.size() <= 128
        && data.phoneNumber == request.auth.token.get('phone_number', null)
        && (data.phoneNumber == null ||
          (data.phoneNumber is string && data.phoneNumber.size() <= 16))
        && data.displayName is string && data.displayName.size() >= 2
        && data.displayName.size() <= 60
        && data.roles is list && data.roles.size() >= 1 && data.roles.size() <= 2
        && data.roles.hasOnly(['customer', 'host'])
        && data.onboardingCompleted == true
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow read: if isOwner(uid) && verifiedIdentity();
      allow create: if isOwner(uid) && verifiedIdentity()
        && validUser(request.resource.data)
        && request.resource.data.roles == ['customer']
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && verifiedIdentity()
        && validUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phoneNumber', 'onboardingCompleted', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.roles == resource.data.roles;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
